# Copier en .env (ignoré par Git), puis renseigner le connecteur communiqué.
# Ne jamais committer le mot de passe ni une DATABASE_URL contenant le secret.
DATABASE_URL=

# Si DATABASE_URL reste vide, ces identifiants non secrets sont les valeurs par défaut :
PGHOST=db.rnlfbeksplyoywweoddo.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

# Schéma standardisé déjà utilisé par adaptateur_base.py :
PG_TRIALS_SCHEMA=trialstd
PG_TRIALS_TABLE=trials
PG_TRIALS_JSON_COLUMN=json

# Facultatif : chemin vers un certificat CA si nécessaire (TLS verify-full).
# PGSSLROOTCERT=/chemin/ca.pem

# Supabase : CA publique incluse dans certs/supabase-prod-ca-2021.crt.
# Aucun telechargement au demarrage ; sslmode=verify-full reste obligatoire.
# PGSSLROOTCERT remplace la CA par defaut ; sslrootcert dans DATABASE_URL est prioritaire.
